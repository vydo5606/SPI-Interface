probe -create -shm SPI_interface_tb.CSN SPI_interface_tb.MISO SPI_interface_tb.MISO_enable SPI_interface_tb.MOSI SPI_interface_tb.SCLK SPI_interface_tb.SPI_data_out SPI_interface_tb.error_count SPI_interface_tb.i SPI_interface_tb.mem_addr SPI_interface_tb.mem_read_data SPI_interface_tb.mem_read_req SPI_interface_tb.mem_write_data SPI_interface_tb.mem_write_req SPI_interface_tb.rst_n SPI_interface_tb.spi_data SPI_interface_tb.tb_clk SPI_interface_tb.test_memory SPI_interface_tb.testcase
